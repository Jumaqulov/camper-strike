{
  "name": "camper-strike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "description": "Camper Strike 65 - 3D LAN multiplayer FPS: TDM / FFA / Forest Survival (Three.js + Socket.IO)",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "npm run build && tsx src/server/index.ts",
    "serve": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/shared/__tests__/*.test.ts src/client/game/terrain/__tests__/*.test.ts src/client/game/character/__tests__/*.test.ts src/client/game/animation/__tests__/*.test.ts src/client/game/__tests__/*.test.ts",
    "test:perf": "tsx --test --test-concurrency=1 src/shared/__perf__/*.perf.test.ts",
    "validate:assets": "node tools/asset-validation/validate-stage04a-assets.mjs && node tools/grass-validation/validate-grass-assets.mjs && node tools/outdoor-validation/validateOutdoorAssets.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
